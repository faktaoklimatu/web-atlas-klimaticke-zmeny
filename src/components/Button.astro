---
/**
 * Button — Figma node 81:1282. Single tone in mono.
 * variant: outlined | text (they differ only by the border). Hover, on pointer
 * devices, underlines the label. Renders as <a> when `href` is set. `disabled`
 * swaps the background to blue-gray-200 with a default cursor; so does
 * `aria-pressed="true"` (the homepage grid/list toggle's active state — kept
 * focusable rather than disabled). Extra attributes (data-*, aria-*) pass
 * through to the element.
 */
type Variant = 'outlined' | 'text';

interface Props {
  variant?: Variant;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const {
  variant = 'outlined',
  href,
  type = 'button',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const hasIconLeft = Astro.slots.has('icon-left');
const hasIconRight = Astro.slots.has('icon-right');
---

<Tag
  class:list={['btn', `btn--${variant}`, className]}
  href={href}
  type={href ? undefined : type}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  {...rest}
>
  {hasIconLeft && <span class="btn__icon"><slot name="icon-left" /></span>}
  <span class="btn__label"><slot>Button</slot></span>
  {hasIconRight && <span class="btn__icon"><slot name="icon-right" /></span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--size-0-5); /* 2px */
    min-height: var(--size-9); /* 36px */
    padding: var(--size-1-5) var(--size-3); /* 6px 12px */
    border: 1px solid transparent;
    border-radius: var(--size-1-5); /* 6px */
    background: transparent;
    color: inherit;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
    line-height: normal;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease,
      border-color 0.15s ease;
  }

  .btn__label {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--size-1); /* 4px */
  }

  .btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--size-6); /* 24px */
    height: var(--size-6);
  }

  /* --- Variants (same label colour; only the border/background differ) --- */
  .btn--outlined {
    background: var(--white);
    border-color: var(--gray-300);
  }
  .btn--outlined,
  .btn--text { color: var(--text-primary); }

  /* Hover underlines the label — pointer devices only, so it never sticks on
     touch. */
  @media (hover: hover) {
    .btn:hover .btn__label { text-decoration: underline; }
    .btn:disabled:hover .btn__label,
    .btn[aria-disabled='true']:hover .btn__label,
    .btn[aria-pressed='true']:hover .btn__label { text-decoration: none; }
  }

  /* --- Disabled --- */
  .btn:disabled,
  .btn[aria-disabled='true'] {
    background: var(--blue-gray-200);
    cursor: default;
  }

  /* --- Pressed (homepage grid/list toggle) — stays focusable/operable, only
     styled to look "selected"; not disabled, so screen-reader and keyboard
     users can still perceive and reach the currently-active option. */
  .btn[aria-pressed='true'] {
    background: var(--blue-gray-200);
    cursor: default;
  }
</style>
