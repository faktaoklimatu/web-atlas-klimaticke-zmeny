---
/** CloseIcon — a plain ✕ cross for dismiss/close controls. */
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 20 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path d="M18 6 6 18M6 6l12 12"></path>
</svg>
