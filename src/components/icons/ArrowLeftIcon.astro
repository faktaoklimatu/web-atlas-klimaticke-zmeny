---
/** ArrowLeftIcon — a plain leftward arrow for back / return controls. */
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 16 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path d="M19 12H5"></path>
  <path d="M12 19l-7-7 7-7"></path>
</svg>
