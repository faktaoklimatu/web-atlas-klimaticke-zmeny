---
/**
 * Nav — Figma node 48:1351 ("Top Nav"), two variants:
 *   • Variant2 (hero, ~208px): 72px title + subtitle, shown on page load.
 *   • Default (compact, 69px): 24px title, shown after scrolling.
 * The bar is fixed; it collapses hero → compact on scroll (see <script>).
 * The FancyBar sits fixed above it. The globe opens a language switcher whose
 * entries come from `siblings` (later wired to the CMS sibling list).
 */
import GlobeIcon from './icons/GlobeIcon.astro';

interface Sibling {
  code: string;
  flag?: string;
  url: string;
}
interface MenuLink {
  label: string;
  url: string;
}
interface Props {
  /** Header menu links (edited in the CMS: Settings → Navigation). */
  menuLinks?: MenuLink[];
  /** Language versions for the switcher (CMS: Settings → Navigation). */
  siblings?: Sibling[];
  brandHref?: string;
  /** Start (and stay) in the compact bar — used on detail pages. */
  compact?: boolean;
  class?: string;
}

const {
  menuLinks = [],
  siblings = [],
  brandHref = import.meta.env.BASE_URL,
  compact = false,
  class: className,
} = Astro.props;
---

<header
  class:list={['nav', className]}
  data-nav
  data-compact={compact ? '' : undefined}
>
  <div class="nav__inner">
    <a class="nav__brand" href={brandHref}>
      <span class="nav__title">Atlas of climate change</span>
      <span class="nav__subtitle">A Visual Guide to the Science and Data</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        menuLinks.map((l) => (
          <a class="nav__link type-nav-link" href={l.url}>{l.label}</a>
        ))
      }

      <div class="nav__lang" data-lang>
        <button
          type="button"
          class="nav__lang-toggle"
          aria-label="Change language"
          aria-expanded="false"
          aria-haspopup="true"
          data-lang-toggle
        >
          <GlobeIcon size={20} />
        </button>

        <div class="nav__lang-menu" role="menu">
          {
            siblings.map((s) => (
              <a class="nav__lang-item type-mono" href={s.url} role="menuitem">
                <span class="nav__lang-flag" aria-hidden="true">{s.flag}</span>
                <span class="nav__lang-code">{s.code}</span>
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    /* 0 = hero, 1 = compact. Driven linearly from scroll (see <script>);
       every size below interpolates between the two states via this var. */
    --nav-progress: 0;
    position: fixed;
    top: var(--size-3-5); /* 14px — sits below the FancyBar */
    left: 0;
    right: 0;
    z-index: 90;
    display: flex;
    justify-content: center;
    /* block padding 48px (hero) → 20px (compact) */
    padding: calc(48px - 28px * var(--nav-progress)) var(--size-9);
    background: var(--blue-700); /* #1d4ed8 */
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--white);
  }

  /* Detail pages start (and stay) compact — no scroll wiring runs there. */
  .nav[data-compact] {
    --nav-progress: 1;
  }

  .nav__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--size-8); /* 32px */
    width: 100%;
    max-width: 1280px;
  }

  .nav__brand {
    display: flex;
    flex-direction: column;
    /* row gap 6px → 0 so the collapsing subtitle leaves no empty gap */
    gap: calc(6px - 6px * var(--nav-progress));
    color: var(--white);
    text-decoration: none;
  }

  .nav__title {
    font-family: var(--font-sans);
    font-weight: 600;
    /* 72px (hero) → 24px (compact) */
    font-size: calc(72px - 48px * var(--nav-progress));
    line-height: 1.2;
    /* -2.88px → -0.48px */
    letter-spacing: calc(-2.88px + 2.4px * var(--nav-progress));
    white-space: nowrap;
  }

  .nav__subtitle {
    max-width: 680px;
    overflow: hidden;
    /* 40px → 0 */
    max-height: calc(40px - 40px * var(--nav-progress));
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.1;
    letter-spacing: -0.36px;
    color: #f3f3f3;
    opacity: calc(1 - var(--nav-progress));
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--size-8); /* 32px */
    flex: none;
  }

  .nav__link {
    color: var(--white);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__link:hover { text-decoration: underline; }

  /* --- Language switcher --- */
  .nav__lang { position: relative; }

  .nav__lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-6); /* 24px */
    height: var(--size-6);
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    cursor: pointer;
    border-radius: var(--size-1);
  }
  .nav__lang-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5);
  }

  .nav__lang-menu {
    position: absolute;
    top: calc(100% + var(--size-2)); /* 8px below */
    right: 0;
    display: none;
    flex-direction: column;
    min-width: 72px;
    background: var(--white);
    border: 1px solid var(--gray-300);
    border-radius: var(--size-1-5); /* 6px */
    overflow: hidden;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  }
  .nav.is-lang-open .nav__lang-menu { display: flex; }

  .nav__lang-item {
    display: flex;
    align-items: center;
    gap: var(--size-0-5); /* 2px */
    min-height: var(--size-9); /* 36px */
    padding: var(--size-1-5) var(--size-3); /* 6px 12px */
    color: var(--text-primary);
    text-decoration: none;
  }
  .nav__lang-item + .nav__lang-item { border-top: 1px solid var(--gray-300); }
  .nav__lang-item:hover { background: var(--gray-50); }
  .nav__lang-flag { font-size: 14px; }
  .nav__lang-code { padding: 0 var(--size-1); }

  /* --- Small screens: fixed compact bar (--bp-lg 1024) ---
     The bar stops interpolating with scroll and keeps one small height. The
     subtitle joins the title on the same line in regular weight. Literal font
     sizes below win over the base calc()s regardless of --nav-progress, so the
     feed's scroll wiring can keep running harmlessly. */
  @media (max-width: 1024px) {
    .nav {
      /* fixed small height — no more hero → compact travel; side padding
         stays at the page gutter (--size-9 = 36) like every other section */
      padding: var(--size-3) var(--size-9); /* 12px 36px */
    }
    .nav__inner {
      align-items: center;
      gap: var(--size-2) var(--size-4); /* row 8, column 16 */
      /* If the brand + links can't fit on one line, the links wrap below
         instead of overflowing past the (fixed, unclipped) viewport edge. */
      flex-wrap: wrap;
      min-width: 0;
    }
    .nav__brand {
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      min-width: 0;
      gap: var(--size-2); /* 8px between title and subtitle */
    }
    .nav__title {
      font-size: var(--size-5); /* 20px */
      letter-spacing: -0.4px;
      /* Allow the title to wrap on very narrow phones instead of forcing the
         (fixed) header wider than the viewport. */
      white-space: normal;
    }
    .nav__subtitle {
      /* on the same line as the title, regular weight */
      max-width: none;
      max-height: none;
      opacity: 1;
      font-weight: 400;
      font-size: var(--size-3-5); /* 14px */
      letter-spacing: -0.28px;
    }
    /* Em dash separating the inline subtitle from the title. */
    .nav__subtitle::before { content: '— '; }
  }

  /* Too small to fit the subtitle — drop it entirely (--bp-xs 480). */
  @media (max-width: 480px) {
    .nav__subtitle { display: none; }
  }
</style>

<script>
  // The nav element is swapped on every ClientRouter navigation, so we keep a
  // module-level handle and re-point it on `astro:page-load` (fires on the
  // initial load and after each navigation). Listeners on window/document
  // persist across swaps, so they're wired once and read this handle.
  let nav: HTMLElement | null = null;

  // We want the bar's BOTTOM edge to move at the same speed as the scrolling
  // content (1px scroll → 1px shrink), so nothing appears to slide relative to
  // the bar. The nav's height is NOT linear in --nav-progress (near the end the
  // links row becomes the tallest element and only the padding keeps shrinking),
  // so a linear scroll→progress map only matches the average speed, not the
  // instantaneous one. Instead we sample height(progress) on load and invert it:
  // for a given scroll we solve for the progress whose height = hero − scroll.
  const SAMPLES = 24;
  let heightByProgress: number[] = []; // offsetHeight at progress i/SAMPLES

  const measure = () => {
    if (!nav || nav.hasAttribute('data-compact')) return;
    const prev = nav.style.getPropertyValue('--nav-progress');
    heightByProgress = [];
    for (let i = 0; i <= SAMPLES; i++) {
      nav.style.setProperty('--nav-progress', String(i / SAMPLES));
      heightByProgress.push(nav.offsetHeight);
    }
    if (prev) nav.style.setProperty('--nav-progress', prev);
    else nav.style.removeProperty('--nav-progress');
  };

  // Progress whose nav height equals (hero − scroll), by linear interpolation
  // between the two bracketing samples. Height decreases as progress increases.
  const progressForScroll = (scroll: number) => {
    const hero = heightByProgress[0];
    const compact = heightByProgress[SAMPLES];
    const target = hero - Math.max(scroll, 0);
    if (target >= hero) return 0;
    if (target <= compact) return 1;
    for (let i = 0; i < SAMPLES; i++) {
      const hi = heightByProgress[i];
      const lo = heightByProgress[i + 1];
      if (target <= hi && target >= lo) {
        const span = hi - lo || 1;
        return (i + (hi - target) / span) / SAMPLES;
      }
    }
    return 1;
  };

  const applyProgress = () => {
    // Detail pages are always compact (CSS pins --nav-progress:1); skip them.
    if (!nav || nav.hasAttribute('data-compact') || !heightByProgress.length)
      return;
    nav.style.setProperty(
      '--nav-progress',
      progressForScroll(window.scrollY).toFixed(4),
    );
  };

  const closeLang = () => {
    if (!nav) return;
    nav.classList.remove('is-lang-open');
    nav
      .querySelector('[data-lang-toggle]')
      ?.setAttribute('aria-expanded', 'false');
  };

  window.addEventListener('scroll', applyProgress, { passive: true });
  window.addEventListener('resize', () => {
    measure();
    applyProgress();
  });

  document.addEventListener('click', (event) => {
    const langWrap = nav?.querySelector('[data-lang]');
    if (langWrap && !langWrap.contains(event.target as Node | null)) closeLang();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLang();
  });

  // (Re)bind to the current nav on first load and after every navigation.
  document.addEventListener('astro:page-load', () => {
    nav = document.querySelector('[data-nav]');
    measure();
    applyProgress();

    const toggle = nav?.querySelector('[data-lang-toggle]');
    toggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = nav!.classList.toggle('is-lang-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  });
</script>
