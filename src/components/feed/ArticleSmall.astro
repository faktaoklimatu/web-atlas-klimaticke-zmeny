---
/**
 * ArticleSmall — grid-view card. Figma: Section/Grid → ArticleSmall (135:4558).
 * Same bordered/gradient container as ArticleCard (list view), scaled down —
 * smaller padding, same title size. Grid stretches every card in a row to the
 * tallest (default CSS Grid align-items), and the link's space-between keeps
 * the graphic pinned to the bottom regardless of title length.
 */
interface Props {
  title: string;
  image: string;
  slug: string;
  chapterId: string;
  href?: string;
}
import { imgUrl } from '../../utils/img';
const { title, image, slug, chapterId, href = '#' } = Astro.props;
const src = imgUrl(image);
---

<article class="scard" data-slug={slug} data-chapter={chapterId}>
  <a class="scard__link" href={href}>
    <h3 class="scard__title type-card-title">{title}</h3>
    <div class="scard__media">
      <img src={src} alt={title} loading="lazy" decoding="async" />
    </div>
  </a>
</article>

<style>
  .scard {
    scroll-margin-top: 110px;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--gray-300);
    border-radius: var(--size-2); /* 8px */
    overflow: hidden;
    background: linear-gradient(to bottom, var(--blue-gray-100) 0%, var(--white) 15%);
  }
  .scard__link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--size-3); /* 12px */
    height: 100%;
    padding: var(--size-3) var(--size-3) 0; /* 12px 12px 0 */
    text-decoration: none;
  }
  .scard__title {
    margin: 0;
    color: var(--text-primary);
  }
  /* Aspect tuned to the atlas images (5906×4157) so a uniform scale crops
     3% off each side, 14% off the top, and leaves the bottom flush. */
  .scard__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1.8;
    overflow: hidden;
    background: var(--gray-100);
  }
  .scard__media img {
    position: absolute;
    left: -2%;
    bottom: -5%;
    width: 104%;
    height: auto; /* keep aspect ratio — no distortion */
    max-width: none;
    display: block;
  }

  /* Hover (pointer devices only — never sticks on touch). */
  @media (hover: hover) {
    .scard {
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .scard:has(.scard__link:hover) {
      border-color: var(--gray-400);
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.1);
    }
  }
</style>
