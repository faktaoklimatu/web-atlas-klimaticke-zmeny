---
/**
 * ViewToggle — grid/list switch. Figma: Buttons Group (315:1069).
 * A ButtonGroup of two text Buttons; the active one has `aria-pressed="true"`
 * (blue-gray-200 background, stays focusable). Behaviour is wired in feed-spy
 * via [data-view-btn]; feed-overlay
 * relocates the whole `.viewtoggle` between the desktop toolbar and mobile bar.
 */
import ButtonGroup from '../ButtonGroup.astro';
import Button from '../Button.astro';
import ListIcon from '../icons/ListIcon.astro';
import GridIcon from '../icons/GridIcon.astro';
import { ui } from '../../data/ui';

interface Props {
  initial?: 'grid' | 'list';
  class?: string;
}
const { initial = 'grid', class: className } = Astro.props;
---

<ButtonGroup
  class:list={['viewtoggle', className]}
  role="group"
  aria-label={ui.feed.viewMode}
>
  <Button
    variant="text"
    data-view-btn="list"
    aria-pressed={initial === 'list' ? 'true' : 'false'}
  >
    <ListIcon slot="icon-left" size={16} />
    {ui.feed.list}
  </Button>
  <Button
    variant="text"
    data-view-btn="grid"
    aria-pressed={initial === 'grid' ? 'true' : 'false'}
  >
    <GridIcon slot="icon-left" size={16} />
    {ui.feed.grid}
  </Button>
</ButtonGroup>
