---
/**
 * Shared 1.8-aspect card teaser, used by ArticleCard/ArticleSmall/RelatedCard
 * so their crop stays in sync. Uniform scale to the export template's
 * content-area margins (see CroppedInfographic) so the red margin never
 * shows — sides flush with the content edges, top cropped into the content
 * to fit 1.8.
 */
interface Props {
  src: string;
  alt: string;
  rounded?: boolean;
  loading?: 'lazy' | 'eager';
}
const { src, alt, rounded = false, loading = 'lazy' } = Astro.props;
---

<div class="teaser-image" class:list={{ 'teaser-image--rounded': rounded }}>
  <img src={src} alt={alt} loading={loading} decoding="async" />
</div>

<style>
  .teaser-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1.8;
    overflow: hidden;
    background: var(--white);
  }
  .teaser-image--rounded {
    border-radius: var(--size-2); /* 8px */
  }
  .teaser-image img {
    position: absolute;
    left: -6.1856%;
    top: -34.0365%;
    width: 112.4504%;
    height: auto; /* keep aspect ratio — no distortion */
    max-width: none;
    display: block;
  }
</style>
