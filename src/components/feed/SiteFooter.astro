---
/**
 * SiteFooter — Figma: footer of the grid page (117:1203).
 * Social links + sponsors, then a language switcher and copyright.
 * Sits inside the content column, below the feed.
 */
import FacebookIcon from '../icons/FacebookIcon.astro';
import InstagramIcon from '../icons/InstagramIcon.astro';
import XIcon from '../icons/XIcon.astro';
import LinkedInIcon from '../icons/LinkedInIcon.astro';
import { ui } from '../../data/ui';

interface Sibling {
  code: string;
  flag?: string;
  url: string;
}
interface Props {
  /** Language versions from the CMS (Settings → Navigation, via site.json). */
  siblings?: Sibling[];
}
const { siblings = [] } = Astro.props;
---

<footer class="footer">
  <div class="footer__top">
    <div class="footer__social">
      <p class="footer__label">{ui.footer.followUs}</p>
      <div class="footer__icons">
        <a href="#" aria-label={ui.footer.social.facebook}><FacebookIcon size={22} /></a>
        <a href="#" aria-label={ui.footer.social.instagram}><InstagramIcon size={22} /></a>
        <a href="#" aria-label={ui.footer.social.x}><XIcon size={22} /></a>
        <a href="#" aria-label={ui.footer.social.linkedin}><LinkedInIcon size={22} /></a>
      </div>
    </div>

    <div class="footer__sponsors">
      <p class="footer__label">{ui.footer.sponsorsLabel}</p>
      <div class="footer__logos">
        {Array.from({ length: 4 }).map(() => <span>{ui.footer.sponsorPlaceholder}</span>)}
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__lang" role="group" aria-label={ui.footer.languageLabel}>
      {
        siblings.map((s) => (
          <a class="footer__lang-item type-mono" href={s.url}>
            <span aria-hidden="true">{s.flag}</span>
            <span>{s.code}</span>
          </a>
        ))
      }
    </div>

    <div class="footer__legal">
      <p>{ui.footer.copyright}</p>
      <p><a href="https://creativecommons.org/licenses/by/4.0/">{ui.footer.license}</a></p>
      <p><a href={`mailto:${ui.footer.email}`}>{ui.footer.email}</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--size-16); /* 64px */
    padding-top: var(--size-10); /* 40px */
    border-top: 1px solid var(--gray-200);
    font-family: var(--font-sans);
    color: var(--text-secondary);
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: var(--size-10);
    flex-wrap: wrap;
  }
  .footer__label {
    margin: 0 0 var(--size-3);
    font-size: 15px;
    color: var(--text-secondary);
  }
  .footer__icons { display: flex; gap: var(--size-3); }
  .footer__icons a { color: var(--text-primary); display: inline-flex; }
  .footer__icons a:hover { color: var(--blue-600); }

  .footer__logos { display: flex; gap: var(--size-4); }
  .footer__logos span {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
    transform: rotate(-8deg);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--size-6);
    margin-top: var(--size-8);
    padding-bottom: var(--size-12);
  }

  .footer__lang {
    display: inline-flex;
    background: var(--white);
    border: 1px solid var(--gray-300);
    border-radius: var(--size-1-5);
    overflow: hidden;
  }
  .footer__lang-item {
    display: inline-flex;
    align-items: center;
    gap: var(--size-0-5);
    min-height: var(--size-9);
    padding: var(--size-1-5) var(--size-3);
    color: var(--text-primary);
    text-decoration: none;
  }
  .footer__lang-item + .footer__lang-item { box-shadow: inset 1px 0 0 var(--gray-300); }
  .footer__lang-item:hover { background: var(--gray-50); }

  .footer__legal { text-align: right; font-size: 14px; color: var(--text-tertiary); }
  .footer__legal p { margin: 0 0 var(--size-1); }
  .footer__legal a { color: var(--text-tertiary); }
  .footer__legal a:hover { color: var(--blue-600); }
</style>
