---
/**
 * SiteFooter — Figma: footer of the grid page (117:1203).
 * Atlas title + PDF download, then social links; a language switcher +
 * "get it in your language" link, then copyright. Sits inside the content
 * column, below the feed.
 */
import ButtonGroup from '../ButtonGroup.astro';
import Button from '../Button.astro';
import { imgUrl } from '../../utils/img';
import { ui } from '../../data/ui';

interface Sibling {
  code: string;
  flag?: string;
  url: string;
}
interface SocialLink {
  label: string;
  url: string;
  icon: string;
}
interface Props {
  /** Language versions from the CMS (Settings → Navigation, via site.json). */
  siblings?: Sibling[];
  /** Social icon links from the CMS (Settings → Navigation, via site.json). */
  socialLinks?: SocialLink[];
  /** Atlas PDF download from the CMS; hidden when empty. */
  atlasPdfUrl?: string;
  /** "Get the Atlas in your language" link target; hidden when empty. */
  languageVersionsUrl?: string;
  /** Copyright/license/contact — a single CMS-edited paragraph. */
  footerLegal?: string;
}
const {
  siblings = [],
  socialLinks = [],
  atlasPdfUrl,
  languageVersionsUrl,
  footerLegal,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
    <div class="footer__brand">
      <p class="footer__label">{ui.siteTitle}</p>
      {atlasPdfUrl && (
        <Button variant="outlined" href={`${base}${atlasPdfUrl}`} target="_blank" rel="noopener noreferrer">
          {ui.footer.downloadPdf}
        </Button>
      )}
    </div>

    <div class="footer__social">
      <p class="footer__label">{ui.footer.followUs}</p>
      <div class="footer__icons">
        {
          socialLinks.map((s) => (
            <a href={s.url} aria-label={s.label} target="_blank" rel="noopener noreferrer">
              <img src={imgUrl(s.icon)} alt="" width="22" height="22" />
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer__languages">
      <p class="footer__label">{ui.footer.languageLabel}</p>
      <ButtonGroup role="group" aria-label={ui.footer.languageLabel}>
        {
          siblings.map((s) => (
            <Button variant="text" href={s.url} target="_blank" rel="noopener noreferrer">
              {s.flag && <span slot="icon-left" aria-hidden="true">{s.flag}</span>}
              {s.code}
            </Button>
          ))
        }
      </ButtonGroup>
      {languageVersionsUrl && (
        <div class="footer__lang-link">
          <Button variant="text" href={languageVersionsUrl} target="_blank" rel="noopener noreferrer">
            {ui.footer.getInYourLanguage}
          </Button>
        </div>
      )}
    </div>

    <div class="footer__legal">
      <p class="footer__label">{footerLegal}</p>
    </div>

</footer>

<style>
  .footer {
    margin-top: var(--size-16); /* 64px */
    padding: var(--size-10) 0; /* 40px */
    border-top: 1px solid var(--gray-200);
    font-family: var(--font-sans);
    color: var(--text-secondary);
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--size-8);
    row-gap: var(--size-8);
  }

  /* Phones: stack to a single column. */
  @media (max-width: 640px) {
    .footer { grid-template-columns: 1fr; }
  }

  /* Large phone (--bp-xs 480): tighter gap above the footer, matching the
     side gutter (was 64px). */
  @media (max-width: 480px) {
    .footer { margin-top: var(--size-4); }
  }


  .footer__label {
    margin: 0 0 var(--size-3);
    font-size: 15px;
    color: var(--text-secondary);
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__icons { display: flex; gap: var(--size-3); }
  .footer__icons a { display: inline-flex; }
  .footer__icons img { display: block; width: 22px; height: 22px; }
  @media (hover: hover) {
    .footer__icons a { transition: opacity 0.15s ease; }
    .footer__icons a:hover { opacity: 0.7; }
  }

  .footer__languages { display: flex; flex-direction: column; align-items: flex-start; }
  .footer__lang-link { margin-top: var(--size-1); /* 4px */ }
  .footer__lang-link :global(.btn) { padding: 0; min-height: 0; }
  .footer__lang-link :global(.btn__label) { padding: 0; }

  .footer__legal { text-align: left; }
  .footer__legal .footer__label { margin: 0; }
</style>
