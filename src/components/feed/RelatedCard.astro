---
/**
 * RelatedCard — Previous/Next infographic card in the detail sidebar.
 * Same bordered/gradient container + crop as the homepage grid's
 * ArticleSmall, so previews look identical wherever they appear.
 */
interface Props {
  title: string;
  image: string;
  href: string;
}
import { imgUrl } from '../../utils/img';
const { title, image, href } = Astro.props;
const src = imgUrl(image);
---

<a class="related" href={href}>
  <h3 class="related__title type-card-title">{title}</h3>
  <div class="related__media">
    <img src={src} alt={title} loading="lazy" decoding="async" />
  </div>
</a>

<style>
  .related {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--size-3); /* 12px */
    border: 1px solid var(--gray-300);
    border-radius: var(--size-2); /* 8px */
    overflow: hidden;
    background: linear-gradient(to bottom, var(--blue-gray-100) 0%, var(--white) 15%);
    padding: var(--size-3) var(--size-3) 0; /* 12px 12px 0 */
    text-decoration: none;
  }
  .related__title {
    margin: 0;
    color: var(--text-primary);
  }
  /* Aspect tuned to the atlas images (5906×4157) so a uniform scale crops
     3% off each side, 14% off the top, and leaves the bottom flush. */
  .related__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1.8;
    overflow: hidden;
    background: var(--gray-100);
  }
  .related__media img {
    position: absolute;
    left: -2%;
    bottom: -5%;
    width: 104%;
    height: auto; /* keep aspect ratio — no distortion */
    max-width: none;
    display: block;
  }
  @media (hover: hover) {
    .related { transition: border-color 0.2s ease, box-shadow 0.2s ease; }
    .related:hover {
      border-color: var(--gray-400);
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.1);
    }
  }
</style>
