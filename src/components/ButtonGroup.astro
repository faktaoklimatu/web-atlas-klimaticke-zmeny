---
/**
 * ButtonGroup — Figma node 85:1090.
 * A bordered container that joins Button children with 1px separators.
 * Children should be borderless (Button variant="text"); the group supplies
 * the frame + dividers. `direction` = row | column.
 */
interface Props {
  direction?: 'row' | 'column';
  class?: string;
  [attr: string]: unknown;
}
const { direction = 'row', class: className, ...rest } = Astro.props;
---

<div class:list={['buttongroup', `buttongroup--${direction}`, className]} {...rest}>
  <slot />
</div>

<style>
  .buttongroup {
    display: inline-flex;
    align-items: stretch;
    background: var(--white);
    border: 1px solid var(--gray-300);
    border-radius: var(--size-1-5); /* 6px */
    overflow: hidden;
  }
  .buttongroup--row { flex-direction: row; }
  .buttongroup--column { flex-direction: column; }

  /* Drop the child's own frame (the group supplies border + radius). Removing
     the 1px border too — not just the radius — lets the dividers span the full
     height and a filled/disabled child meet the divider with no white gap. */
  .buttongroup > :global(.btn) { border: 0; border-radius: 0; }

  /* 1px separators drawn with an inset box-shadow so the child's `border`
     shorthand can't override them. */
  .buttongroup--row > :global(* + *) { box-shadow: inset 1px 0 0 var(--gray-300); }
  .buttongroup--column > :global(* + *) { box-shadow: inset 0 1px 0 var(--gray-300); }
</style>
