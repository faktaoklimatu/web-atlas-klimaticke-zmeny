---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FancyBar from '../components/FancyBar.astro';
import Nav from '../components/Nav.astro';
import Tag from '../components/Tag.astro';
import ButtonGroup from '../components/ButtonGroup.astro';
import Button from '../components/Button.astro';
import RelatedCard from '../components/feed/RelatedCard.astro';
import ExternalLinkIcon from '../components/icons/ExternalLinkIcon.astro';
import CodeIcon from '../components/icons/CodeIcon.astro';
import { chapterName } from '../data/chapters';
import { getFlatInfographics } from '../data/infographics';
import { imgUrl } from '../utils/img';
import site from '../data/site.json';
import { ui } from '../data/ui';

export async function getStaticPaths() {
  const flat = await getFlatInfographics();
  const lookup = new Map(flat.map((f) => [f.slug, f]));

  const entries = await getCollection('infographics');
  const entryBySlug = new Map<string, (typeof entries)[number]>(
    entries.map((e) => [e.id, e])
  );

  return flat.map((item, i) => {
    const entry = entryBySlug.get(item.slug)!;

    // Related: prefer the CMS relation list, else the next 2 (wrapping).
    const relatedSlugs =
      entry.data.related && entry.data.related.length
        ? entry.data.related
        : [flat[(i + 1) % flat.length].slug, flat[(i + 2) % flat.length].slug];
    const related = relatedSlugs
      .map((s) => lookup.get(s))
      .filter(Boolean)
      .map((r) => ({ slug: r!.slug, title: r!.title, image: r!.image }));

    return { params: { slug: item.slug }, props: { entry, related } };
  });
}

const { entry, related } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = data.title;
const lead = data.lead;
const chapterLabel = chapterName(data.chapter);
const imgSrc = imgUrl(data.image);

const pdfHref = data.downloads?.pdf || null;
const tableUrl = data.data?.tableUrl || null;
const sourceUrl = data.data?.sourceUrl || null;
const citation = data.data?.citation || '';
const hasDataLinks = tableUrl || sourceUrl;
const hasUnderlyingData = hasDataLinks || citation;

const href = (slug: string) => `${base}/${slug}/`;
---

<Layout title={`${title} — ${ui.siteTitle}`}>
  <FancyBar />
  <Nav compact menuLinks={site.menuLinks} siblings={site.languages} />

  <!-- Fixed split background (same as the feed). -->
  <div class="detail-bg" aria-hidden="true">
    <div class="detail-bg__fill detail-bg__fill--left"></div>
    <div class="detail-bg__center">
      <div class="detail-bg__col detail-bg__col--sidebar"></div>
      <div class="detail-bg__col detail-bg__col--content"></div>
    </div>
    <div class="detail-bg__fill detail-bg__fill--right"></div>
  </div>

  <div class="detail">
    <div class="detail__spacer"></div>

    <div class="detail__center">
      <div class="detail__main">
        <aside class="detail__sidebar-col">
          <div class="detail__sidebar-sticky">
            <div class="meta" data-meta-root>
              <section class="meta__block" data-meta="download">
                <h2 class="meta__label type-eyebrow">{ui.detail.download}</h2>
                <ButtonGroup direction="row">
                  {pdfHref && (
                    <Button variant="text" href={`${base}${pdfHref}`}>{ui.detail.pdf}</Button>
                  )}
                  <Button variant="text" href={imgSrc}>{ui.detail.png}</Button>
                </ButtonGroup>
              </section>

              {hasUnderlyingData && (
                <section class="meta__block" data-meta="data">
                  <h2 class="meta__label type-eyebrow">{ui.detail.underlyingData}</h2>
                  <div class="meta__data">
                    {hasDataLinks && (
                      <ButtonGroup direction="column">
                        {tableUrl && (
                          <Button variant="text" href={tableUrl}>
                            <ExternalLinkIcon slot="icon-left" size={16} />
                            {ui.detail.dataTable}
                          </Button>
                        )}
                        {sourceUrl && (
                          <Button variant="text" href={sourceUrl}>
                            <CodeIcon slot="icon-left" size={16} />
                            {ui.detail.dataSource}
                          </Button>
                        )}
                      </ButtonGroup>
                    )}
                    {citation && <p class="meta__source type-small">{citation}</p>}
                  </div>
                </section>
              )}

              {related.length > 0 && (
                <section class="meta__block" data-meta="related">
                  <h2 class="meta__label type-eyebrow">{ui.detail.moreArticles}</h2>
                  <div class="meta__related">
                    {related.map((r) => (
                      <RelatedCard title={r.title} image={r.image} href={href(r.slug)} />
                    ))}
                  </div>
                </section>
              )}
            </div>
          </div>
        </aside>

        <div class="detail__content">
          <div class="detail__hero">
            <div class="detail__hero-inner">
              <div class="detail__titles">
                <h1 class="detail__title type-title">{title}</h1>
                <p class="detail__lead type-lead">{lead}</p>
              </div>
              <div class="detail__media">
                <img src={imgSrc} alt={title} />
              </div>
            </div>
          </div>

          <!-- Small screens (≤ --bp-lg): the sidebar's Download + Underlying
               data blocks relocate here, directly under the infographic. -->
          <div class="detail__inline-meta" data-inline-meta></div>

          <div class="detail__body">
            <div class="detail__prose">
              <Content />
            </div>
          </div>

          <!-- Small screens: the sidebar's More articles block relocates here,
               after the end of the article. -->
          <div class="detail__end-meta" data-end-meta></div>
        </div>
      </div>
    </div>

    <div class="detail__spacer"></div>
  </div>
</Layout>

<style is:global>
  body { padding: 0; }
  /* Clip the hero's right full-bleed at the root instead of on .detail, so no
     ancestor of the sidebar has a non-visible overflow (which would break its
     position: sticky). overflow-y stays visible → the page still scrolls and
     the sticky sidebar references the viewport. */
  html { overflow-x: clip; }
</style>

<style>
  .detail {
    --top-clear: 79px; /* FancyBar 10 + compact nav 69 */
    /* Pin the sidebar exactly at its natural offset (col padding-top below),
       so it's fixed from the first scrolled pixel — no sticky "settle" travel. */
    --sticky-top: calc(var(--top-clear) + var(--size-12)); /* 79 + 48 = 127px */
    /* Distance from the centre column's edge to the viewport edge — i.e. the
       spacer width. Full-bleed pseudo-elements extend by exactly this instead
       of a whole -100vw (which would overflow ~a full viewport and, in touch
       mode, stretch the fixed nav + background layer past the visible edge). */
      --edge: max(var(--size-9), calc((100vw - 1280px) / 2));
    position: relative;
    display: flex;
    align-items: stretch;
    /* No overflow here: any non-visible overflow on an ancestor would break
       the sidebar's position: sticky. The hero's right bleed is clipped at
       the root instead (html { overflow-x: clip }). */
  }

  /* Fixed split background */
  .detail-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    pointer-events: none;
  }
  /* min-width matches the nav's 36px side padding (--size-9) so the content
     column lines up with the navigation instead of sitting closer to the edge. */
  .detail-bg__fill { flex: 1 1 0; min-width: var(--size-9); }
  .detail-bg__fill--left { background: var(--blue-gray-200); }
  .detail-bg__fill--right { background: var(--blue-gray-100); }
  .detail-bg__center {
    flex: 0 1 1280px;
    min-width: 0;
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
  }
  .detail-bg__col--sidebar { background: var(--blue-gray-200); }
  .detail-bg__col--content { background: var(--blue-gray-100); }

  .detail__spacer { flex: 1 1 0; min-width: var(--size-9); } /* matches nav padding */

  .detail__center {
    position: relative;
    z-index: 1;
    flex: 0 1 1280px;
    min-width: 0;
    display: flex;
  }
  .detail__main {
    flex: 1;
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
    min-width: 0;
  }

  /* Sidebar meta panel */
  .detail__sidebar-col {
    padding: calc(var(--top-clear) + var(--size-12)) var(--size-9) 0 0; /* top matches --sticky-top; right gap 36 */
    border-right: 1px solid var(--blue-gray-100);
  }
  .detail__sidebar-sticky {
    position: sticky;
    top: var(--sticky-top);
    /* Stay pinned while the content scrolls. Only if the panel itself is
       taller than the viewport does it scroll — and then only when the
       cursor is over it (that's where the scroll container lives). */
    max-height: calc(100vh - var(--sticky-top) - var(--size-6));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--size-10); /* 40px */
    align-items: flex-start;
  }
  .meta__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* button groups hug, source/related stretch */
    gap: var(--size-4); /* 16px */
    width: 100%;
  }
  /* Left-align the content inside the sidebar buttons. */
  .meta :global(.btn) { justify-content: flex-start; }
  .meta__label {
    margin: 0;
    color: var(--text-primary);
  }
  .meta__data {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
    gap: var(--size-2);
  }
  .meta__source {
    align-self: stretch;
    margin: 0;
    color: var(--text-tertiary);
  }
  .meta__related {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
  }

  /* Content */
  .detail__content { position: relative; min-width: 0; }

  .detail__hero {
    position: relative;
    z-index: 0;
    padding: calc(var(--top-clear) + var(--size-12)) 0 var(--size-16) var(--size-24);
  }
  /* White band that bleeds to the right viewport edge (clipped by .detail). */
  .detail__hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 calc(-1 * var(--edge)) 0 0; /* bleed right, exactly to the edge */
    background: var(--white);
  }
  .detail__hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* tag hugs its content instead of stretching */
    gap: var(--size-6); /* 24px */
    max-width: 894px;
  }
  .detail__titles {
    display: flex;
    flex-direction: column;
    gap: var(--size-2); /* 8px */
    width: 100%;
  }
  .detail__title {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__lead {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__media {
    width: 100%;
    aspect-ratio: 894 / 460;
    overflow: hidden;
    border-radius: var(--size-2);
  }
  .detail__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .detail__body {
    display: flex;
    flex-direction: column;
    gap: var(--size-12); /* 48px */
    padding: var(--size-16) 0 var(--size-24) var(--size-24); /* top 64, left 96, bottom 96 */
    max-width: 894px;
  }
  .detail__intro {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__sections {
    display: flex;
    flex-direction: column;
    gap: var(--size-8); /* 32px */
    max-width: 600px;
  }
  .detail__section { display: flex; flex-direction: column; gap: var(--size-3); }
  .detail__section h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .detail__section p {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__section a {
    color: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
  }
  .detail__section a:hover { color: var(--blue-600); }

  /* Rendered markdown body (from the CMS). */
  .detail__prose { max-width: 600px; }
  .detail__prose :global(h2) {
    margin: var(--size-8) 0 var(--size-3);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .detail__prose :global(h2:first-child) { margin-top: 0; }
  .detail__prose :global(p) {
    margin: 0 0 var(--size-4);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__prose :global(ul),
  .detail__prose :global(ol) {
    margin: 0 0 var(--size-4);
    padding-left: var(--size-6);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__prose :global(li) { margin-bottom: var(--size-2); }
  .detail__prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
  }
  .detail__prose :global(a:hover) { color: var(--blue-600); }

  /* Mount points for the relocated sidebar blocks — desktop keeps them empty
     and hidden; JS reveals + fills them at ≤ --bp-lg (see the <script>). */
  .detail__inline-meta,
  .detail__end-meta { display: none; }

  /* =====================================================================
     Small screens (≤ --bp-lg 1024): single column. The sidebar's Download +
     Underlying data blocks move directly under the infographic, and More
     articles moves to the end of the article. See the <script>.
     ===================================================================== */
  @media (max-width: 1024px) {
    /* Uniform background — no sidebar tint band. */
    .detail-bg__center { grid-template-columns: 1fr; }
    .detail-bg__col--sidebar { display: none; }
    .detail-bg__fill--left { background: var(--blue-gray-100); }

    .detail__main { grid-template-columns: 1fr; }
    .detail__sidebar-col { display: none; }

    /* Single column: the 36px spacer is the ONLY side gutter (same as the
       nav), so hero + body drop their side padding — text lands at the same
       inset as the navigation. */
    .detail__hero { padding-left: 0; }
    .detail__body { padding-left: 0; }

    /* With no sidebar, the hero's white band bleeds to BOTH edges so there's
       no leftover blue-gray spacer strip beside it on the left. */
    .detail__hero::before {
      inset: 0 calc(-1 * var(--edge)) 0 calc(-1 * var(--edge));
    }

    /* Relocated Download + Underlying data, sitting under the infographic —
       kept on the same white band as the hero (buttons stay on white). */
    .detail__inline-meta {
      position: relative;
      z-index: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-8); /* 32px */
      padding: var(--size-8) 0; /* text aligns with the nav via the spacer */
    }
    .detail__inline-meta::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: 0 calc(-1 * var(--edge)); /* full-bleed white, exactly to edges */
      background: var(--white);
    }
    .detail__inline-meta .meta__block {
      width: auto;
      min-width: min(240px, 100%);
    }
    .detail__inline-meta :global(.btn) { justify-content: flex-start; }

    /* Relocated More articles, after the end of the article. */
    .detail__end-meta {
      display: block;
      padding: 0 0 var(--size-16); /* 96px bottom breathing room */
    }
    .detail__end-meta .meta__related {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--size-4);
    }
  }

  /* Very small: stack the relocated related cards. */
  @media (max-width: 480px) {
    .detail__end-meta .meta__related { grid-template-columns: 1fr; }
  }
</style>

<script>
  import '../scripts/detail-meta';
</script>
